{
  "protocol": "circle_cctp",
  "version": "v1",
  "deployment_source": "https://developers.circle.com/cctp/v1/evm-smart-contracts",
  "abi_sources": {
    "DepositForBurn": "https://github.com/circlefin/evm-cctp-contracts/blob/master/src/TokenMessenger.sol",
    "MessageReceived": "https://github.com/circlefin/evm-cctp-contracts/blob/master/src/MessageTransmitter.sol"
  },
  "correlation_key": {
    "description": "sourceDomain concatenated with nonce",
    "composite_fields": ["sourceDomain", "nonce"]
  },
  "deployments": [
    {
      "chain": "ethereum",
      "chain_id": 1,
      "domain": 0,
      "contracts": {
        "token_messenger": "0xBd3fa81B58Ba92a82136038B25aDec7066af3155",
        "message_transmitter": "0x0a992d191DEeC32aFe36203Ad87D7d289a738F81"
      }
    },
    {
      "chain": "arbitrum",
      "chain_id": 42161,
      "domain": 3,
      "contracts": {
        "token_messenger": "0x19330d10D9Cc8751218eaf51E8885D058642E08A",
        "message_transmitter": "0xC30362313FBBA5cf9163F0bb16a0e01f01A896ca"
      }
    },
    {
      "chain": "base",
      "chain_id": 8453,
      "domain": 6,
      "contracts": {
        "token_messenger": "0x1682Ae6375C4E4A97e4B583BC394c861A46D8962",
        "message_transmitter": "0xAD09780d193884d503182aD4588450C416D6F9D4"
      }
    }
  ],
  "abi": [
    {
      "type": "event",
      "name": "DepositForBurn",
      "anonymous": false,
      "inputs": [
        {
          "name": "nonce",
          "type": "uint64",
          "indexed": true,
          "internalType": "uint64"
        },
        {
          "name": "burnToken",
          "type": "address",
          "indexed": true,
          "internalType": "address"
        },
        {
          "name": "amount",
          "type": "uint256",
          "indexed": false,
          "internalType": "uint256"
        },
        {
          "name": "depositor",
          "type": "address",
          "indexed": true,
          "internalType": "address"
        },
        {
          "name": "mintRecipient",
          "type": "bytes32",
          "indexed": false,
          "internalType": "bytes32"
        },
        {
          "name": "destinationDomain",
          "type": "uint32",
          "indexed": false,
          "internalType": "uint32"
        },
        {
          "name": "destinationTokenMessenger",
          "type": "bytes32",
          "indexed": false,
          "internalType": "bytes32"
        },
        {
          "name": "destinationCaller",
          "type": "bytes32",
          "indexed": false,
          "internalType": "bytes32"
        }
      ]
    },
    {
      "type": "event",
      "name": "MessageReceived",
      "anonymous": false,
      "inputs": [
        {
          "name": "caller",
          "type": "address",
          "indexed": true,
          "internalType": "address"
        },
        {
          "name": "sourceDomain",
          "type": "uint32",
          "indexed": false,
          "internalType": "uint32"
        },
        {
          "name": "nonce",
          "type": "uint64",
          "indexed": true,
          "internalType": "uint64"
        },
        {
          "name": "sender",
          "type": "bytes32",
          "indexed": false,
          "internalType": "bytes32"
        },
        {
          "name": "messageBody",
          "type": "bytes",
          "indexed": false,
          "internalType": "bytes"
        }
      ]
    }
  ]
}
